{
  "id": "face_eye_color",
  "version": "1.0.0",
  "displayName": "Eye Colour",
  "category": "beauty",
  "description": "Recolours and brightens the irises, clipped to the eyelids so a blink stays clean.",
  "order": 706,
  "requires": "face",
  "parameters": [
    {
      "identifier": "shade",
      "displayName": "Shade",
      "type": "color",
      "defaultValue": "#3a7fa8"
    },
    {
      "identifier": "strength",
      "displayName": "Strength",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.7
    },
    {
      "identifier": "brighten",
      "displayName": "Brighten",
      "type": "float",
      "minValue": 0,
      "maxValue": 0.6,
      "defaultValue": 0.15
    },
    {
      "identifier": "pupilKeep",
      "displayName": "Keep pupil",
      "type": "float",
      "minValue": 0,
      "maxValue": 0.9,
      "defaultValue": 0.45
    },
    {
      "identifier": "faceIndex",
      "displayName": "Face",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0
    }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [{ "type": "source_texture" }],
        "output": { "type": "canvas" }
      }
    ]
  }
}
