{
  "id": "face_brow_tint",
  "version": "1.0.0",
  "displayName": "Brow Tint",
  "category": "beauty",
  "description": "Darkens and colours the brow hairs without flooding the skin between them.",
  "order": 705,
  "requires": "face",
  "parameters": [
    {
      "identifier": "shade",
      "displayName": "Shade",
      "type": "color",
      "defaultValue": "#4a3020"
    },
    {
      "identifier": "strength",
      "displayName": "Strength",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.55
    },
    {
      "identifier": "density",
      "displayName": "Density",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.5
    },
    {
      "identifier": "feather",
      "displayName": "Feather",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.4
    },
    {
      "identifier": "faceIndex",
      "displayName": "Face",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0
    }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [{ "type": "source_texture" }],
        "output": { "type": "canvas" }
      }
    ]
  }
}
