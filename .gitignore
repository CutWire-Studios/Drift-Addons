# staging/: commit fonts, images, JSON, shaders. Large weights/libs stay out of git;
# a sibling <name>.sha256 is committed instead (see recipes/staging_hashes.py).
staging/.cache/
staging/**/*.onnx
staging/**/*.bin
staging/**/*.so
staging/**/*.so.*
staging/**/*.dylib
staging/**/*.dll
!staging/**/*.sha256
