{
  "name": "drift-addons-worker",
  "private": true,
  "scripts": {
    "dev": "python3 ../packer/config.py >/dev/null && wrangler dev --config wrangler.local.jsonc",
    "deploy": "python3 ../packer/config.py >/dev/null && wrangler deploy --config wrangler.local.jsonc",
    "typecheck": "python3 ../packer/config.py >/dev/null && wrangler types --config wrangler.local.jsonc && tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
