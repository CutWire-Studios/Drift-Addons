      {
        "id": "bright",
        "scale": 1.0
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "bright.frag",
        "inputs": [
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "buffer",
          "id": "bright"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "rays.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "bright"
          },
          {
            "type": "source_texture"
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  }
}
