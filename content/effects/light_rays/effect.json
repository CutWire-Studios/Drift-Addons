{
  "id": "light_rays",
  "displayName": "Light Rays",
  "category": "dreamy",
  "order": 800,
  "parameters": [
    {
      "identifier": "intensity",
      "displayName": "Intensity",
      "type": "float",
      "defaultValue": 0.7,
      "minValue": 0.0,
      "maxValue": 2
    },
    {
      "identifier": "threshold",
      "displayName": "Threshold",
      "type": "float",
      "defaultValue": 0.7,
      "minValue": 0.0,
      "maxValue": 1.0
    },
    {
      "identifier": "rayLength",
      "displayName": "Length",
      "type": "float",
      "defaultValue": 0.55,
      "minValue": 0.0,
      "maxValue": 1
    },
    {
      "identifier": "centerX",
      "displayName": "Center X",
      "type": "float",
      "defaultValue": 0.5,
      "minValue": 0.0,
      "maxValue": 1.0
    },
    {
      "identifier": "centerY",
      "displayName": "Center Y",
      "type": "float",
      "defaultValue": 0.35,
      "minValue": 0.0,
      "maxValue": 1.0
    },
    {
      "identifier": "samples",
      "displayName": "Samples",
      "type": "float",
      "defaultValue": 16,
      "minValue": 6,
      "maxValue": 32
    }
  ],
  "backend": "gpu",
  "pipeline": {
