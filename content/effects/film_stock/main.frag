vec3 stockGrade(int s, vec3 c) {
    c = clamp(c, vec3(0.0), vec3(1.0));
    // per-channel power tables (avoids pow(), including its 0^0 edge case)
    float pr[4 + 1], pg[4 + 1], pb[4 + 1];
    pr[0] = 1.0; pg[0] = 1.0; pb[0] = 1.0;
    for (int d = 1; d <= 4; d++) {
        pr[d] = pr[d - 1] * c.r;
        pg[d] = pg[d - 1] * c.g;
        pb[d] = pb[d - 1] * c.b;
    }
    float t[NT];
    int n = 0;
    for (int i = 0; i <= 4; i++)
        for (int j = 0; j <= 4 - i; j++)
            for (int k = 0; k <= 4 - i - j; k++)
                t[n++] = pr[i] * pg[j] * pb[k];
    vec3 o = vec3(0.0);
    for (int ch = 0; ch < 3; ch++) {
        float acc = 0.0;
        int base = (s * 3 + ch) * NT;
        for (int m = 0; m < NT; m++)
            acc += t[m] * PK[base + m];
        o[ch] = acc;
    }
    return clamp(o, vec3(0.0), vec3(1.0));
}

void main() {
    vec4 src = texture(u_currentTexture, v_texCoord);
    int s = clamp(stock, 0, NSTOCK - 1);
    vec3 graded = stockGrade(s, src.rgb);
    fragColor = vec4(mix(src.rgb, graded, clamp(strength, 0.0, 1.0)), src.a);
}
