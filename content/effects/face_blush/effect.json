{
  "id": "face_blush",
  "version": "1.0.0",
  "displayName": "Blush",
  "category": "beauty",
  "description": "Soft colour on the cheeks, clipped to the face so it cannot spill onto hair.",
  "order": 701,
  "requires": "face",
  "parameters": [
    {
      "identifier": "shade",
      "displayName": "Shade",
      "type": "color",
      "defaultValue": "#e8798c"
    },
    {
      "identifier": "intensity",
      "displayName": "Intensity",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.4
    },
    {
      "identifier": "size",
      "displayName": "Size",
      "type": "float",
      "minValue": 0.15,
      "maxValue": 1,
      "defaultValue": 0.45
    },
    {
      "identifier": "feather",
      "displayName": "Feather",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.6
    },
    {
      "identifier": "faceIndex",
      "displayName": "Face",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0
    }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [{ "type": "source_texture" }],
        "output": { "type": "canvas" }
      }
    ]
  }
}
