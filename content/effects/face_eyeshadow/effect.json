{
  "id": "face_eyeshadow",
  "version": "1.0.0",
  "displayName": "Eyeshadow",
  "category": "beauty",
  "description": "Colour swept above each upper lid, cut out of the eye and capped below the brow.",
  "order": 704,
  "requires": "face",
  "parameters": [
    {
      "identifier": "shade",
      "displayName": "Shade",
      "type": "color",
      "defaultValue": "#7a4f8c"
    },
    {
      "identifier": "intensity",
      "displayName": "Intensity",
      "type": "float",
      "minValue": 0,
      "maxValue": 1,
      "defaultValue": 0.5
    },
    {
      "identifier": "spread",
      "displayName": "Spread",
      "type": "float",
      "minValue": 0.1,
      "maxValue": 1,
      "defaultValue": 0.45
    },
    {
      "identifier": "feather",
      "displayName": "Feather",
      "type": "float",
      "minValue": 0.05,
      "maxValue": 1,
      "defaultValue": 0.6
    },
    {
      "identifier": "faceIndex",
      "displayName": "Face",
      "type": "float",
      "minValue": 0,
      "maxValue": 3,
      "defaultValue": 0
    }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [{ "type": "source_texture" }],
        "output": { "type": "canvas" }
      }
    ]
  }
}
